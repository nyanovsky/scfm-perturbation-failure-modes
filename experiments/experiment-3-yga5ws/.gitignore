# Keeps heavy bytes out of git (and future worktree snapshots) — durable heavy
# outputs belong in $SILICO_EXPERIMENT_ARTIFACTS_DIR, not the worktree.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.bin
*.onnx
wandb/
tensorboard/
*.tfevents.*
# SLURM job logs (SBATCH_OUTPUT defaults here) — read on disk, not a deliverable.
slurm-logs/
# Python build noise — never a deliverable, only clutters the changeset.
__pycache__/
*.pyc
# Stranded _atomic_write temps (name.<pid>.<hex>.tmp) from a crashed write.
*.*.*.tmp
# Short-lived presigned links + the helper that composes them: both embed live
# (1 hour) AWS session credentials, so neither is ever committed. The mechanism
# is documented in the README; the refs they point at are in config.py.
results/handoff/urls/
scratch/make_url_manifest.py
_work/
# Copies of job outputs pulled down for a quick look; the durable copy is in
# the artifact store, not here.
scratch/**/*.parquet
scratch/**/*.json
scratch/dl/
jobs/target_urls.json
# Concatenations of the sweep shards, regenerated by scfm_pfm.analysis; the
# shards themselves are the durable copy in the artifact store.
results/summary/per_perturbation.parquet
results/summary/transfer_per_perturbation.parquet
results/summary/concat_per_perturbation.parquet
scratch/*.txt
scratch/*.log
