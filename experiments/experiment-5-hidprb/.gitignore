# Keeps heavy bytes out of git (and future worktree snapshots) — durable heavy
# outputs belong in $SILICO_EXPERIMENT_ARTIFACTS_DIR, not the worktree.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.bin
*.onnx
wandb/
tensorboard/
*.tfevents.*
# SLURM job logs (SBATCH_OUTPUT defaults here) — read on disk, not a deliverable.
slurm-logs/
# Python build noise — never a deliverable, only clutters the changeset.
__pycache__/
*.pyc
# Stranded _atomic_write temps (name.<pid>.<hex>.tmp) from a crashed write.
*.*.*.tmp

# Scratch is one-off probes, downloads and dead ends: never a deliverable, and
# it holds short-lived signed artifact-store links that embed live one-hour
# credentials. None of it is committed.
scratch/

# pytest cache — a local artefact of running the suite, never a deliverable.
.pytest_cache/
